{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automergeType": "pr",
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["require", "indirect", "replace"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "rebaseWhen": "behind-base-branch"
    },
    {
      "matchManagers": ["gomod", "mise"],
      "matchDatasources": ["golang-version", "github-tags"],
      "matchPackageNames": ["go", "golang/go"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "rebaseWhen": "behind-base-branch"
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "matchPackageNames": ["!StackVista/renovate-config"],
      "matchUpdateTypes": ["patch", "minor", "digest", "pin", "pinDigest"],
      "automerge": true,
      "rebaseWhen": "behind-base-branch"
    },
    {
      "matchManagers": ["github-actions", "custom.regex"],
      "matchPackageNames": ["goreleaser/goreleaser"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "rebaseWhen": "behind-base-branch"
    },
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["patch", "digest", "pinDigest"],
      "automerge": true,
      "rebaseWhen": "behind-base-branch"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "quay.io/stackstate/**",
        "ghcr.io/stackvista/**",
        "stackstate/**",
        "docker.io/stackstate/**",
        "registry.tooling.stackstate.io/{quay/stackstate,docker/stackstate,ghcr/stackvista}/**"
      ],
      "matchUpdateTypes": ["minor"],
      "automerge": true,
      "rebaseWhen": "behind-base-branch"
    },
    {
      "matchManagers": ["gomod"],
      "matchPackageNames": ["k8s.io/**", "sigs.k8s.io/**"],
      "matchUpdateTypes": ["minor"],
      "automerge": false,
      "rebaseWhen": "conflicted"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchDepTypes": ["syntax"],
      "automerge": false,
      "rebaseWhen": "conflicted"
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "rebaseWhen": "conflicted"
    }
  ]
}
