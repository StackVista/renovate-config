{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchCategories": ["!security"],
      "groupName": "Node dependencies",
      "groupSlug": "node-deps"
    },
    {
      "matchManagers": ["nvm", "nodenv", "mise"],
      "matchCategories": ["!security"],
      "groupName": "Node toolchain",
      "groupSlug": "node-toolchain"
    },
    {
      "matchDepNames": ["node"],
      "matchCategories": ["!security"],
      "groupName": "Node toolchain",
      "groupSlug": "node-toolchain"
    }
  ]
}
