{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "minimumReleaseAge": "0 days",
  "automerge": false,
  "rebaseWhen": "conflicted",
  "dependencyDashboard": false,
  "prCreation": "immediate",
  "prConcurrentLimit": 0,
  "prHourlyLimit": 5,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "minimumReleaseAge": null
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update version variables annotated with Renovate metadata.",
      "managerFilePatterns": [
        "/(^|/|\\.)Dockerfile$/",
        "/(^|/)Dockerfile[^/]*$/",
        "/(^|/)Makefile$/",
        "/scripts/.*\\.sh$/",
        "/(^|/)\\.github/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: packageName=(?<packageName>[^\\s]+))?(?: versioning=(?<versioning>[^\\s]+))?(?: extractVersion=(?<extractVersion>[^\\s]+))?\\s+.+_(?:version|VERSION).*[:=](?:\\s|\\\"|)(?<currentValue>[^\\\"\\s]+)(?:\\\"|)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "all patch and minor dependencies",
      "groupSlug": "all-patch-minor"
    },
    {
      "matchManagers": ["github-actions", "custom.regex"],
      "groupName": null,
      "groupSlug": null
    },
    {
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action"],
      "matchUpdateTypes": ["patch", "minor", "digest", "pin", "pinDigest"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "minimumReleaseAge": "7 days",
      "internalChecksFilter": "strict"
    },
    {
      "matchSourceUrls": ["https://github.com/StackVista/**", "https://gitlab.com/stackvista/**"],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchPackageNames": [
        "StackVista/**",
        "github.com/StackVista/**",
        "gitlab.com/stackvista/**",
        "quay.io/stackstate/**",
        "ghcr.io/stackvista/**",
        "stackstate/**",
        "docker.io/stackstate/**",
        "registry.tooling.stackstate.io/{quay/stackstate,docker/stackstate,ghcr/stackvista}/**"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies/major"],
      "addLabels": ["dependencies/major"],
      "groupName": null,
      "groupSlug": null,
      "prPriority": -1
    },
    {
      "matchUpdateTypes": ["patch"],
      "prPriority": 10
    },
    {
      "matchJsonata": ["isVulnerabilityAlert = true or $exists(vulnerabilityFixVersion)"],
      "minimumReleaseAge": null,
      "prPriority": 20
    }
  ],
  "schedule": ["at any time"]
}
