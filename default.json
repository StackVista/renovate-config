{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "minimumReleaseAge": "0 days",
  "automerge": false,
  "dependencyDashboard": false,
  "prCreation": "immediate",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 5,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "minimumReleaseAge": null
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update version variables annotated with Renovate metadata.",
      "managerFilePatterns": [
        "/(^|/|\\.)Dockerfile$/",
        "/(^|/)Dockerfile[^/]*$/",
        "/(^|/)Makefile$/",
        "/scripts/.*\\.sh$/",
        "/(^|/)\\.github/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)(?: packageName=(?<packageName>[^\\s]+))?(?: versioning=(?<versioning>[^\\s]+))?(?: extractVersion=(?<extractVersion>[^\\s]+))?\\s+.+_(?:version|VERSION).*[:=](?:\\s|\\\"|)(?<currentValue>[^\\\"\\s]+)(?:\\\"|)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "all patch and minor dependencies",
      "groupSlug": "all-patch-minor"
    },
    {
      "matchCategories": ["security"],
      "groupName": "security patches",
      "groupSlug": "security",
      "minimumReleaseAge": null
    }
  ],
  "schedule": ["at any time"]
}
