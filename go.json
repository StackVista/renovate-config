{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchCategories": ["!security"],
      "groupName": "Go module dependencies",
      "groupSlug": "go-deps"
    },
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang", "toolchain"],
      "matchCategories": ["!security"],
      "groupName": "Go toolchain",
      "groupSlug": "go-toolchain"
    },
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["tool"],
      "matchCategories": ["!security"],
      "groupName": "Go tools",
      "groupSlug": "go-tools"
    }
  ],
  "postUpdateOptions": ["gomodTidy"]
}
