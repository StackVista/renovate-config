{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchCategories": ["!security"],
      "groupName": "Go module dependencies",
      "groupSlug": "go-deps"
    },
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang", "toolchain"],
      "matchCategories": ["!security"],
      "groupName": "Go toolchain",
      "groupSlug": "go-toolchain"
    },
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["toolchain"],
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": null
    },
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["tool"],
      "matchCategories": ["!security"],
      "groupName": "Go tools",
      "groupSlug": "go-tools"
    },
    {
      "description": "Skip AWS SDK changelogs because GitHub tag queries time out",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/aws/aws-sdk-go-v2{,/**}"],
      "fetchChangeLogs": "off"
    }
  ],
  "postUpdateOptions": ["gomodTidy"]
}
